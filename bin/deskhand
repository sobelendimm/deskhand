#!/usr/bin/python3
"""deskhand komutu: `python3 -m deskhand "$@"`.
Paketi bu dosyanın gerçek konumuna göre bulur (bin/../deskhand); bağlantıyla (~/.local/bin/ekran → …) çağrılabilir.
PYTHONPATH kullanılmaz: `ac` ile başlatılan uygulamalara sızmasın."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from deskhand.cli import main  # noqa: E402

main()
